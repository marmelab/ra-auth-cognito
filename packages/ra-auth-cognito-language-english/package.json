{
    "name": "ra-auth-cognito-language-english",
    "version": "2.0.0",
    "repository": "git@github.com:marmelab/ra-auth-cognito.git",
    "author": "Guillaume Pierson <guillaumep@marmelab.com> (https://marmelab.com/)",
    "license": "MIT",
    "files": [
        "*.md",
        "dist",
        "src"
    ],
    "type": "module",
    "zshy": {
        "exports": "./src/index.ts",
        "noEdit": true
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "sideEffects": false,
    "peerDependencies": {
        "ra-auth-cognito": "^2.0.0"
    },
    "scripts": {
        "build": "zshy --silent",
        "lint": "eslint --fix ./src"
    },
    "devDependencies": {
        "ra-auth-cognito": "workspace:^",
        "typescript": "^5.5.4",
        "zshy": "^0.5.0"
    }
}
